# Copie para .env.local e preencha. O build é feito na sua máquina (npm run build / npm run publish).
# Nunca coloque senhas ou tokens neste arquivo.

# Número do WhatsApp que recebe os contatos: somente dígitos, com DDI + DDD.
# Exemplo de formato: 55DDNNNNNNNNN
# ATENÇÃO: variáveis NEXT_PUBLIC_* são públicas e embutidas no build.
# Alterar este valor exige rebuild da aplicação.
# Se ficar vazio, o site mostra um aviso no lugar do formulário.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Opcional: verificação por meta tag (prefira a verificação por DNS TXT).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
